rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function email() { return request.auth.token.email.lower(); }
  function role() { return signed() && request.auth.token.email_verified == true ? (email() in ['camiloguerra2010@gmail.com', 'rodricgt3@gmail.com'] ? 'camilo_owner' : (exists(/databases/$(database)/documents/access/$(email())) ? get(/databases/$(database)/documents/access/$(email())).data.role : 'member')) : 'member'; }
  function owner() { return role() == 'camilo_owner'; }
  function staff() { return role() in ['camilo_owner', 'spotter_mod']; }
  function self(uid) { return signed() && request.auth.uid == uid; }
  function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
  function bounded(s, n) { return s is string && s.size() > 0 && s.size() <= n; }
  match /access/{address} {
   allow get: if signed() && (address == email() || owner());
   allow list: if owner();
   allow create, update: if owner() && address != email() && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role in ['member', 'spotter_mod'] && (request.resource.data.role != 'spotter_mod' || address in getAfter(/databases/$(database)/documents/settings/staff).data.emails);
   allow delete: if owner() && address != email();
  }
  match /settings/staff {
   allow read: if owner();
   allow write: if owner() && request.resource.data.keys().hasOnly(['emails']) && request.resource.data.emails is list && request.resource.data.emails.size() <= 11;
  }
  match /users/{uid} {
   allow read: if signed();
   allow create: if self(uid) && request.resource.data.keys().hasOnly(['displayName','photoURL','role','rpmPoints','badges','createdAt']) && request.resource.data.role == role() && request.resource.data.rpmPoints == 0 && request.resource.data.badges == ['Fundador / Early Adopter'] && request.resource.data.createdAt == request.time && bounded(request.resource.data.displayName, 100) && request.resource.data.photoURL is string;
   allow update: if (self(uid) && changedOnly(['displayName','photoURL','displayNameChangedAt']) && bounded(request.resource.data.displayName,100) && request.resource.data.photoURL is string && ((request.resource.data.displayName == resource.data.displayName && !request.resource.data.keys().hasAny(['displayNameChangedAt'])) || (request.resource.data.displayName != resource.data.displayName && (!resource.data.keys().hasAny(['displayNameChangedAt']) || resource.data.displayNameChangedAt <= request.time - duration.value(30,'d')) && request.resource.data.displayNameChangedAt == request.time))) || (staff() && changedOnly(['rpmPoints','badges']) && request.resource.data.rpmPoints is int && request.resource.data.rpmPoints >= resource.data.rpmPoints && request.resource.data.rpmPoints <= resource.data.rpmPoints + 1000 && request.resource.data.badges is list && request.resource.data.badges.size() <= 4);
   allow delete: if owner();
   match /pushTokens/{token} {
    allow read, delete: if self(uid);
    allow create, update: if self(uid) && request.resource.data.keys().hasOnly(['token','updatedAt']) && request.resource.data.token == token && token.size() < 2048 && request.resource.data.updatedAt == request.time;
   }
  }
  match /trivias/{id} {
   allow read: if signed();
   allow create: if staff() && request.resource.data.keys().hasOnly(['question','prize','status','expiresAt','createdAt']) && bounded(request.resource.data.question,500) && bounded(request.resource.data.prize,500) && request.resource.data.status == 'active' && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(25,'h') && request.resource.data.createdAt == request.time;
   allow update: if staff() && changedOnly(['status','winnerName','winnerAt']) && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'closed') && (!request.resource.data.keys().hasAny(['winnerName']) || bounded(request.resource.data.winnerName,100)) && (!request.resource.data.keys().hasAny(['winnerAt']) || request.resource.data.winnerAt == request.time);
   allow delete: if owner();
   match /private/{secret} { allow read: if staff(); allow create: if staff() && secret == 'answer' && request.resource.data.keys().hasOnly(['answer']) && bounded(request.resource.data.answer,200); allow update,delete: if owner(); }
   match /submissions/{uid} {
    allow read: if staff() || self(uid);
    allow create: if self(uid) && request.resource.data.keys().hasOnly(['uid','displayName','answer','submittedAt','awarded','delivered','accepted']) && request.resource.data.uid == uid && bounded(request.resource.data.displayName,100) && bounded(request.resource.data.answer,200) && request.resource.data.submittedAt == request.time && request.resource.data.awarded == false && request.resource.data.delivered == false && (!request.resource.data.keys().hasAny(['accepted']) || request.resource.data.accepted == false) && get(/databases/$(database)/documents/trivias/$(id)).data.status == 'active' && get(/databases/$(database)/documents/trivias/$(id)).data.expiresAt > request.time;
    allow update: if staff() && changedOnly(['accepted','awarded','delivered']) && request.resource.data.accepted is bool && request.resource.data.awarded is bool && request.resource.data.delivered is bool && (!resource.data.awarded || request.resource.data.awarded) && (!resource.data.delivered || request.resource.data.delivered);
    allow delete: if owner();
   }
  }
  match /events/{id} {
   function ownRegistrationAfter() { return getAfter(/databases/$(database)/documents/events/$(id)/registrations/$(request.auth.uid)).data; }
   allow read: if signed();
   allow create: if owner() && request.resource.data.keys().hasOnly(['title','date','location','mapUrl','description','mode','capacity','confirmedCount','raffleDrawn','raffleLocked','createdAt']) && bounded(request.resource.data.title,500) && request.resource.data.date > request.time && bounded(request.resource.data.location,500) && request.resource.data.mapUrl is string && request.resource.data.description is string && request.resource.data.mode in ['open','limited','raffle'] && request.resource.data.capacity is int && request.resource.data.capacity >= 0 && request.resource.data.confirmedCount == 0 && request.resource.data.raffleDrawn == false && request.resource.data.createdAt == request.time;
   allow update: if owner() || (signed() && resource.data.mode in ['open','limited'] && resource.data.date > request.time && changedOnly(['confirmedCount']) && request.resource.data.confirmedCount == resource.data.confirmedCount + 1 && (resource.data.mode == 'open' || request.resource.data.confirmedCount <= resource.data.capacity) && !exists(/databases/$(database)/documents/events/$(id)/registrations/$(request.auth.uid)) && ownRegistrationAfter().status == 'confirmed');
   allow delete: if owner();
   match /registrations/{uid} {
    function event() { return get(/databases/$(database)/documents/events/$(id)).data; }
    function eventAfter() { return getAfter(/databases/$(database)/documents/events/$(id)).data; }
    allow read: if self(uid) || staff();
    allow create: if self(uid) && request.resource.data.keys().hasOnly(['uid','displayName','token','status','checkedIn','createdAt']) && request.resource.data.uid == uid && bounded(request.resource.data.displayName,100) && bounded(request.resource.data.token,128) && request.resource.data.checkedIn == false && request.resource.data.createdAt == request.time && event().date > request.time && ((event().mode == 'raffle' && event().raffleDrawn == false && event().get('raffleLocked', false) == false && request.resource.data.status == 'waitlist') || (event().mode in ['open','limited'] && request.resource.data.status == 'confirmed' && eventAfter().confirmedCount == event().confirmedCount + 1 && (event().mode == 'open' || eventAfter().confirmedCount <= event().capacity)));
    allow update: if (staff() && resource.data.status == 'confirmed' && resource.data.checkedIn == false && changedOnly(['checkedIn','checkedInAt']) && request.resource.data.checkedIn == true && request.resource.data.checkedInAt == request.time && getAfter(/databases/$(database)/documents/users/$(uid)).data.rpmPoints == get(/databases/$(database)/documents/users/$(uid)).data.rpmPoints + 500) || (owner() && event().mode == 'raffle' && !event().raffleDrawn && eventAfter().raffleDrawn && resource.data.status == 'waitlist' && changedOnly(['status']) && request.resource.data.status == 'confirmed');
    allow delete: if owner();
   }
  }
  match /earlyAccess/{id} {
   allow read: if signed();
   allow create: if owner() && request.resource.data.keys().hasOnly(['title','url','thumbnail','exclusiveUntil','createdAt']) && bounded(request.resource.data.title,500) && bounded(request.resource.data.url,2000) && bounded(request.resource.data.thumbnail,2000) && request.resource.data.exclusiveUntil is timestamp && request.resource.data.createdAt == request.time;
   allow update, delete: if owner();
   match /reactions/{uid} { allow read: if signed(); allow create,update: if self(uid) && request.resource.data.keys().hasOnly(['uid','emoji']) && request.resource.data.uid == uid && request.resource.data.emoji in ['🔥','🏁','🚀']; allow delete: if self(uid) || staff(); }
   match /comments/{cid} {
    allow read: if signed();
    allow create: if signed() && request.resource.data.keys().hasOnly(['uid','displayName','text','createdAt']) && request.resource.data.uid == request.auth.uid && bounded(request.resource.data.text,500) && bounded(request.resource.data.displayName,100) && request.resource.data.createdAt == request.time;
    allow delete: if staff() || self(resource.data.uid);
   }
  }
  match /marketplace/{id} {
   function order() { return getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data; }
   allow read: if true;
   allow create: if owner() && bounded(request.resource.data.title,500) && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.category in ['merch','autos','piezas'] && request.resource.data.stock is map && request.resource.data.active is bool;
   allow update: if owner() || (staff() && changedOnly(['stock'])) || (signed() && resource.data.active && resource.data.category != 'autos' && changedOnly(['stock','lastOrderId']) && request.resource.data.lastOrderId is string && !exists(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)) && order().uid == request.auth.uid && order().itemId == id && request.resource.data.stock.diff(resource.data.stock).affectedKeys().hasOnly([order().size]) && resource.data.stock[order().size] > 0 && request.resource.data.stock[order().size] == resource.data.stock[order().size] - 1);
   allow delete: if owner();
  }
  match /orders/{id} {
   function item() { return get(/databases/$(database)/documents/marketplace/$(request.resource.data.itemId)).data; }
   function itemAfter() { return getAfter(/databases/$(database)/documents/marketplace/$(request.resource.data.itemId)).data; }
   allow read: if staff() || self(resource.data.uid);
   allow create: if signed() && request.resource.data.keys().hasOnly(['uid','itemId','title','size','price','status','createdAt']) && self(request.resource.data.uid) && item().active && item().category != 'autos' && request.resource.data.title == item().title && request.resource.data.price == item().price && request.resource.data.status == 'reserved' && request.resource.data.createdAt == request.time && itemAfter().lastOrderId == id && item().stock[request.resource.data.size] > 0 && itemAfter().stock[request.resource.data.size] == item().stock[request.resource.data.size] - 1;
   allow update: if staff() && changedOnly(['status']) && request.resource.data.status in ['reserved','paid','fulfilled','cancelled'];
  }
  match /supportTickets/{id} {
   allow read: if staff() || self(resource.data.uid);
   allow create: if signed() && request.resource.data.keys().hasOnly(['uid','displayName','question','answer','status','createdAt']) && self(request.resource.data.uid) && bounded(request.resource.data.displayName,100) && bounded(request.resource.data.question,1000) && request.resource.data.answer == '' && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
   allow update: if staff() && changedOnly(['answer','status','resolvedAt']) && bounded(request.resource.data.answer,1000) && request.resource.data.status == 'resolved' && request.resource.data.resolvedAt == request.time;
   allow delete: if owner() || (staff() && resource.data.status == 'resolved' && resource.data.resolvedAt < request.time - duration.value(3,'d'));
  }
 }
}




